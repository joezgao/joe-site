---
import Base from '../layouts/Base.astro';

const updated = '5 November 2026';
const items = [
  {
    live: false,
    title: 'micrograd 3D',
    body: 'Version one works: the network trains on two moons and its gradients glow in 3D. Next is a mode that replays backprop node by node, then a public demo.',
  },
  {
    live: true,
    title: 'Eden for the Newborn',
    body: 'Rendering the final cut: three shots, sixteen seconds, 1920 × 1080, in Blender.',
  },
  {
    live: false,
    title: 'This site',
    body: 'Version zero. It goes public once it feels right.',
  },
];
---

<Base title="Now" description="What Joe Gao is working on right now.">
  <article class="wrap page">
    <header>
      <h1 class="display">Now</h1>
      <p class="label">Updated {updated}</p>
    </header>

    <ol class="list">
      {
        items.map((it) => (
          <li>
            <h2 class="item-title">
              {it.live && <span class="lamp" aria-hidden="true" />}
              {it.title}
              {it.live && <span class="visually-hidden"> (in progress)</span>}
            </h2>
            <p>{it.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="label note">
      A <a href="https://nownownow.com/about">now page</a>: what has my attention this month.
    </p>
  </article>
</Base>

<style>
  .page {
    display: grid;
    gap: 64px;
    padding-block: 64px 0;
  }
  header {
    display: grid;
    gap: 16px;
  }
  .list {
    list-style: none;
    padding: 0;
    display: grid;
    max-width: var(--measure);
  }
  .list li {
    display: grid;
    gap: 8px;
    padding-block: 32px;
    border-top: 1px solid var(--line);
  }
  .list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .item-title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .list p {
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .page {
      padding-block: 32px 0;
      gap: 48px;
    }
  }
</style>
