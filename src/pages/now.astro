---
import Base from '../layouts/Base.astro';

const updated = '9 November 2026';
const items = [
  {
    live: false,
    title: 'micrograd 3D',
    body: 'Version 1.1: the network trains on two moons, its gradients glow in 3D, and you can step through backprop neuron by neuron. The code is public, and it runs live in the browser.',
  },
  {
    live: false,
    title: 'Attention, in space',
    body: 'Finished: a tiny GPT trained on Shakespeare in pure NumPy, reading in 3D in the browser while you type. The code is public.',
  },
  {
    live: false,
    title: 'Noise, undone',
    body: 'Finished: a tiny diffusion model, trained from scratch in NumPy, turning 4,000 points of noise into a knot in the browser. It completes a trilogy with micrograd 3D and Attention, in space. The code is public.',
  },
  {
    live: false,
    title: 'All the way down',
    body: 'Finished: a browser viewer for WonderZoom’s scale-aware opacity, one maple leaf from 24 cm down to a single stoma. Measured on a real GPU: about 9× faster with the method on when the whole leaf is in view.',
  },
  {
    live: false,
    title: 'Seen from twelve sides',
    body: 'Finished: 3D Gaussian Splatting written from scratch in NumPy; twelve photographs of a stone become 4,000 Gaussians you can scrub through in the browser.',
  },
  {
    live: false,
    title: 'How a model reads',
    body: 'Finished: a byte-pair encoding tokenizer learned from scratch on Shakespeare, shown merge by merge.',
  },
  {
    live: false,
    title: 'Where words live',
    body: 'Finished: three thousand Shakespeare words, placed by the company they keep, in a 3D space you can search.',
  },
  {
    live: false,
    title: 'Karesansui 枯山水',
    body: 'Finished: a dry Zen garden whose rake lines are the level lines of a field. Move a stone and the garden is raked again.',
  },
  {
    live: false,
    title: 'Heptapod',
    body: 'Finished: can a language model write a whole passage at once? A tiny diffusion model and a GPT of the same size, both trained from scratch on Shakespeare, write side by side in the browser.',
  },
  {
    live: false,
    title: 'Almost Ripe',
    body: 'Finished: a story you walk through in the browser, about three minutes, inspired by Harlan Ellison’s I Have No Mouth, and I Must Scream. Every surface, light and sound is made in code. The code is public.',
  },
  {
    live: false,
    title: 'This site',
    body: 'Version zero, now with ten works, each linked to its code. It goes public once it feels right.',
  },
];
---

<Base title="Now" description="What Joe Gao is working on right now.">
  <article class="wrap page">
    <header>
      <h1 class="display">Now</h1>
      <p class="label">Updated {updated}</p>
    </header>

    <ol class="list">
      {
        items.map((it) => (
          <li>
            <h2 class="item-title">
              {it.live && <span class="lamp" aria-hidden="true" />}
              {it.title}
              {it.live && <span class="visually-hidden"> (in progress)</span>}
            </h2>
            <p>{it.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="label note">
      A <a href="https://nownownow.com/about">now page</a>: what has my attention this month.
    </p>
  </article>
</Base>

<style>
  .page {
    display: grid;
    gap: 64px;
    padding-block: 64px 0;
  }
  header {
    display: grid;
    gap: 16px;
  }
  .list {
    list-style: none;
    padding: 0;
    display: grid;
    max-width: var(--measure);
  }
  .list li {
    display: grid;
    gap: 8px;
    padding-block: 32px;
    border-top: 1px solid var(--line);
  }
  .list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .item-title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .list p {
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .page {
      padding-block: 32px 0;
      gap: 48px;
    }
  }
</style>
