---
import Base from '../layouts/Base.astro';

const updated = '6 November 2026';
const items = [
  {
    live: false,
    title: 'micrograd 3D',
    body: 'Version 1.1: the network trains on two moons, its gradients glow in 3D, and you can step through backprop neuron by neuron. Next is a public demo.',
  },
  {
    live: false,
    title: 'Attention, in space',
    body: 'Finished: a tiny GPT trained on Shakespeare in pure NumPy, reading in 3D in the browser while you type. Private for now.',
  },
  {
    live: false,
    title: 'Noise, undone',
    body: 'Finished: a tiny diffusion model, trained from scratch in NumPy, turning 4,000 points of noise into a knot in the browser. It completes a trilogy with micrograd 3D and Attention, in space. Private for now.',
  },
  {
    live: false,
    title: 'All the way down',
    body: 'Finished: a browser viewer for WonderZoom’s scale-aware opacity, one maple leaf from 24 cm down to a single stoma. Measured on a real GPU: about 9× faster with the method on when the whole leaf is in view.',
  },
  {
    live: false,
    title: 'Almost Ripe',
    body: 'Finished: a story you walk through in the browser, about three minutes, inspired by Harlan Ellison’s I Have No Mouth, and I Must Scream. Every surface, light and sound is made in code. Private for now.',
  },
  {
    live: true,
    title: 'Eden for the Newborn',
    body: 'Making the best version of each shot before the final render: three shots, sixteen seconds, 1920 × 1080, in Blender.',
  },
  {
    live: false,
    title: 'This site',
    body: 'Version zero, now with six works. It goes public once it feels right.',
  },
];
---

<Base title="Now" description="What Joe Gao is working on right now.">
  <article class="wrap page">
    <header>
      <h1 class="display">Now</h1>
      <p class="label">Updated {updated}</p>
    </header>

    <ol class="list">
      {
        items.map((it) => (
          <li>
            <h2 class="item-title">
              {it.live && <span class="lamp" aria-hidden="true" />}
              {it.title}
              {it.live && <span class="visually-hidden"> (in progress)</span>}
            </h2>
            <p>{it.body}</p>
          </li>
        ))
      }
    </ol>

    <p class="label note">
      A <a href="https://nownownow.com/about">now page</a>: what has my attention this month.
    </p>
  </article>
</Base>

<style>
  .page {
    display: grid;
    gap: 64px;
    padding-block: 64px 0;
  }
  header {
    display: grid;
    gap: 16px;
  }
  .list {
    list-style: none;
    padding: 0;
    display: grid;
    max-width: var(--measure);
  }
  .list li {
    display: grid;
    gap: 8px;
    padding-block: 32px;
    border-top: 1px solid var(--line);
  }
  .list li:last-child {
    border-bottom: 1px solid var(--line);
  }
  .item-title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .list p {
    color: var(--muted);
  }
  @media (max-width: 480px) {
    .page {
      padding-block: 32px 0;
      gap: 48px;
    }
  }
</style>
