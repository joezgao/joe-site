---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Owl from '../components/Owl.astro';
import { works } from '../data/works';

// Works pair up in two columns. With an odd count, the first one is featured full width so none is left alone.
const featured = (i: number) => i === 0 && works.length % 2 === 1;
---

<Base description="Joe Gao builds things with AI and cares how they feel. Stanford, computer science and AI.">
  <section class="wrap hero">
    <div class="intro">
      <p class="label">Stanford · Computer Science &amp; AI</p>
      <h1 class="display">I build things with AI and care how they feel.</h1>
    </div>
    <Owl />
  </section>

  <section class="wrap works" aria-labelledby="work-heading">
    <h2 id="work-heading" class="label">Work</h2>
    <ul>
      {
        works.map((w, i) => (
          <li class:list={[{ featured: featured(i) }]}>
            <a class="card" href={`/work#${w.id}`}>
              <Picture
                src={w.cover.src}
                alt={w.cover.alt}
                formats={['avif', 'webp']}
                widths={featured(i) ? [640, 1024, 1600, 2240] : [480, 720, 1080]}
                sizes={
                  featured(i)
                    ? '(min-width: 1248px) 1120px, calc(100vw - 2 * clamp(20px, 5vw, 64px))'
                    : '(min-width: 800px) 544px, calc(100vw - 40px)'
                }
                class="still"
              />
              <span class="card-title">{w.title}</span>
              <span class="card-line">{w.tagline}</span>
              <span class="label card-meta">
                {w.live && <span class="lamp" aria-hidden="true" />}
                {w.year} · {w.form}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
    padding-block: 64px 128px;
  }
  .intro {
    display: grid;
    gap: 24px;
    max-width: 560px;
  }

  .works ul {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
  }
  .featured {
    grid-column: 1 / -1;
  }
  .featured .card :global(.still) {
    aspect-ratio: 2 / 1;
  }
  .card {
    display: grid;
    gap: 8px;
    text-decoration: none;
  }
  .card :global(.still) {
    filter: var(--still-rest);
    transition: filter 400ms var(--ease);
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    border-radius: 4px;
    background: var(--surface);
    outline: 1px solid var(--line);
    outline-offset: -1px;
    margin-bottom: 16px;
  }
  .card:hover :global(.still),
  .card:focus-visible :global(.still) {
    filter: none;
  }
  .card-title {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }
  .card-line {
    color: var(--muted);
  }

  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 24px 56px;
    }
    .works ul {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .featured .card :global(.still) {
      aspect-ratio: 16 / 10;
    }
  }
</style>
