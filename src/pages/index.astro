---
import Base from '../layouts/Base.astro';
import Owl from '../components/Owl.astro';
import WorkCard from '../components/WorkCard.astro';
import EssayLink from '../components/EssayLink.astro';
import { works, trilogy, isSeries, seriesLabel } from '../data/works';
import { essaysByWork } from '../data/writing';

const essays = await essaysByWork();

const series = works.filter(isSeries).sort((a, b) => a.series.part - b.series.part);
// Home shows the trilogy only (DESIGN.md: 3–5 projects; Joe 11/9 chose three); everything else is one link to Work.
const others = works.length - series.length;
---

<Base description="Joe Gao builds things with AI and cares how they feel. Stanford, computer science and AI.">
  <section class="wrap hero">
    <div class="intro">
      <p class="label">Stanford · Computer Science &amp; AI</p>
      <h1 class="display">I build things with AI and care how they feel.</h1>
    </div>
    <Owl />
  </section>

  {
    series.length > 0 && (
      <section class="wrap works" aria-labelledby="trilogy-heading">
        <h2 id="trilogy-heading" class="label">
          A trilogy · {trilogy.title}
        </h2>
        <ul class="triptych">
          {series.map((w) => (
            <li>
              <WorkCard
                work={w}
                kicker={seriesLabel(w)}
                widths={[400, 720, 1080]}
                sizes="(min-width: 1248px) 352px, (min-width: 960px) calc((100vw - 2 * clamp(20px, 5vw, 64px) - 64px) / 3), calc(100vw - 40px)"
              />
              <EssayLink essay={essays.get(w.id)} compact />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    others > 0 && (
      <p class="wrap more">
        <a href="/work/">{others} more on Work: research and stories</a>
      </p>
    )
  }
</Base>

<style>
  .more {
    padding-block: 56px 128px;
    color: var(--muted);
  }
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
    padding-block: 64px 128px;
  }
  .intro {
    display: grid;
    gap: 24px;
    max-width: 560px;
  }

  .works + .works {
    margin-top: 112px;
  }
  .works ul {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    gap: 64px 32px;
  }
  .triptych {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  @media (max-width: 960px) {
    .triptych {
      grid-template-columns: 1fr;
      gap: 56px;
    }
  }
  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 24px 56px;
    }
  }
</style>
