---
import Base from '../layouts/Base.astro';
import Owl from '../components/Owl.astro';
import WorkCard from '../components/WorkCard.astro';
import EssayLink from '../components/EssayLink.astro';
import { works, trilogy, research, isSeries, isResearch, seriesLabel } from '../data/works';
import { essaysByWork } from '../data/writing';

const essays = await essaysByWork();

const series = works.filter(isSeries).sort((a, b) => a.series.part - b.series.part);
const researchWorks = works.filter(isResearch);
const rest = works.filter((w) => !isSeries(w) && !isResearch(w));
// Groups pair up in two columns; with an odd count the first is featured full width so none is left alone.
const featuredIn = (group: unknown[]) => (i: number) => i === 0 && group.length % 2 === 1;
const featured = featuredIn(rest);
const researchFeatured = featuredIn(researchWorks);
---

<Base description="Joe Gao builds things with AI and cares how they feel. Stanford, computer science and AI.">
  <section class="wrap hero">
    <div class="intro">
      <p class="label">Stanford · Computer Science &amp; AI</p>
      <h1 class="display">I build things with AI and care how they feel.</h1>
    </div>
    <Owl />
  </section>

  {
    series.length > 0 && (
      <section class="wrap works" aria-labelledby="trilogy-heading">
        <h2 id="trilogy-heading" class="label">
          A trilogy · {trilogy.title}
        </h2>
        <ul class="triptych">
          {series.map((w) => (
            <li>
              <WorkCard
                work={w}
                kicker={seriesLabel(w)}
                widths={[400, 720, 1080]}
                sizes="(min-width: 1248px) 352px, (min-width: 960px) calc((100vw - 2 * clamp(20px, 5vw, 64px) - 64px) / 3), calc(100vw - 40px)"
              />
              <EssayLink essay={essays.get(w.id)} compact />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    researchWorks.length > 0 && (
      <section class="wrap works" aria-labelledby="research-heading">
        <h2 id="research-heading" class="label">
          Research · {research.title}
        </h2>
        <ul class="pairs">
          {researchWorks.map((w, i) => (
            <li class:list={[{ featured: researchFeatured(i) }]}>
              <WorkCard
                work={w}
                widths={researchFeatured(i) ? [640, 1024, 1600, 2240] : [480, 720, 1080]}
                sizes={
                  researchFeatured(i)
                    ? '(min-width: 1248px) 1120px, calc(100vw - 2 * clamp(20px, 5vw, 64px))'
                    : '(min-width: 800px) 544px, calc(100vw - 40px)'
                }
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    rest.length > 0 && (
      <section class="wrap works" aria-labelledby="stories-heading">
        <h2 id="stories-heading" class="label">
          Stories
        </h2>
        <ul class="pairs">
          {rest.map((w, i) => (
            <li class:list={[{ featured: featured(i) }]}>
              <WorkCard
                work={w}
                widths={featured(i) ? [640, 1024, 1600, 2240] : [480, 720, 1080]}
                sizes={
                  featured(i)
                    ? '(min-width: 1248px) 1120px, calc(100vw - 2 * clamp(20px, 5vw, 64px))'
                    : '(min-width: 800px) 544px, calc(100vw - 40px)'
                }
              />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: 64px;
    padding-block: 64px 128px;
  }
  .intro {
    display: grid;
    gap: 24px;
    max-width: 560px;
  }

  .works + .works {
    margin-top: 112px;
  }
  .works ul {
    list-style: none;
    padding: 0;
    margin: 24px 0 0;
    display: grid;
    gap: 64px 32px;
  }
  .triptych {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .pairs {
    grid-template-columns: 1fr 1fr;
  }
  .featured {
    grid-column: 1 / -1;
  }

  @media (max-width: 960px) {
    .triptych {
      grid-template-columns: 1fr;
      gap: 56px;
    }
  }
  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-block: 24px 56px;
    }
    .pairs {
      grid-template-columns: 1fr;
      gap: 56px;
    }
    .works + .works {
      margin-top: 88px;
    }
  }
</style>
