---
// A work's loop video, used in place of its still.
// - The poster is an optimised WebP and paints before the video. It is attached 800px before the card scrolls
//   into view, so off-screen posters do not compete with the fonts at first paint (mobile LCP).
// - No `src` until the video nears the viewport (real lazy-loading; `preload="none"` alone does not stop autoplay).
// - Under prefers-reduced-motion no `src` is ever set: the poster is all you see.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: string; // /loops/<id>.mp4 in public/
  poster: ImageMetadata;
  label: string; // what the loop shows (same as the still's alt text)
  class?: string;
}

const { src, poster, label, class: className } = Astro.props;
const posterImg = await getImage({ src: poster, width: 1280, format: 'webp', quality: 80 });
---

<video
  class:list={['loop', className]}
  data-src={src}
  data-poster={posterImg.src}
  width={posterImg.attributes.width}
  height={posterImg.attributes.height}
  aria-label={label}
  autoplay
  muted
  loop
  playsinline
  preload="none"
  disablepictureinpicture
></video>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const videos = [...document.querySelectorAll<HTMLVideoElement>('video.loop[data-src]')];

  // Posters first, well ahead of the viewport.
  const posters = new IntersectionObserver(
    (entries) => {
      for (const { target: v, isIntersecting } of entries) {
        if (!(v instanceof HTMLVideoElement) || !isIntersecting) continue;
        if (v.dataset.poster) v.poster = v.dataset.poster;
        posters.unobserve(v);
      }
    },
    { rootMargin: '800px 0px' },
  );
  videos.forEach((v) => posters.observe(v));

  const io = new IntersectionObserver(
    (entries) => {
      for (const { target: v, isIntersecting } of entries) {
        if (!(v instanceof HTMLVideoElement) || reduce.matches) continue;
        if (isIntersecting) {
          if (!v.getAttribute('src') && v.dataset.src) v.src = v.dataset.src;
          v.play().catch(() => {});
        } else if (v.getAttribute('src')) {
          v.pause();
        }
      }
    },
    { rootMargin: '200px 0px' },
  );
  videos.forEach((v) => io.observe(v));

  // Turning on reduced motion mid-visit stops the loops and goes back to the posters.
  reduce.addEventListener('change', () => {
    if (!reduce.matches) return;
    for (const v of videos) {
      v.pause();
      v.removeAttribute('src');
      v.load();
    }
  });
</script>
